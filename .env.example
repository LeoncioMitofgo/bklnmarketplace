# Copia este fichero a .env.local y rellena los valores. .env.local nunca se sube al repo.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable: es pública por diseño (va al navegador)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: SOLO servidor (login por usuario/teléfono, tareas de admin). Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# --- App ---
# URL pública (enlaces en emails, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Se añadirán más adelante ---
